{
  "name": "pi-terminal-statusline",
  "version": "0.1.0",
  "description": "Two-row Pi footer with terminal colors, model and effort icons, context, and five-hour/weekly subscription usage bars.",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "statusline", "terminal", "codex", "claude"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElliotLuque/pi-terminal-statusline.git"
  },
  "homepage": "https://github.com/ElliotLuque/pi-terminal-statusline",
  "bugs": {"url": "https://github.com/ElliotLuque/pi-terminal-statusline/issues"},
  "files": ["extensions", "README.md", "LICENSE", "CHANGELOG.md"],
  "pi": {"extensions": ["./extensions/statusline/index.ts"]},
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {"node": ">=22.19.0"},
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "preview": "tsx scripts/preview.ts",
    "prepublishOnly": "pnpm check && pnpm test",
    "release": "node scripts/release.mjs"
  },
  "publishConfig": {"access": "public", "registry": "https://registry.npmjs.org/"},
  "packageManager": "pnpm@12.9.0"
}
